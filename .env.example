# ================================================
# LLM Provider 选择（anthropic 或 openai）
# ================================================
# LLM_PROVIDER=anthropic

# ================================================
# 方案 A: Anthropic（Claude 模型，效果最好）
# ================================================
# ANTHROPIC_API_KEY=sk-ant-xxx
# MODEL_ID=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # 默认，无需设置

# ================================================
# 方案 B: OpenRouter + Step 3.5 Flash（免费，已验证可用）
# ================================================
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-你的key
# MODEL_ID=stepfun/step-3.5-flash:free
# MODEL_CONTEXT_WINDOW=128000

# ================================================
# 方案 C: OpenRouter + Qwen（免费，可能有速率限制）
# ================================================
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-你的key
# MODEL_ID=qwen/qwen3.6-plus:free
# MODEL_CONTEXT_WINDOW=131072

# ================================================
# 方案 D: OpenRouter + DeepSeek（高性价比）
# ================================================
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-你的key
# MODEL_ID=deepseek/deepseek-chat
# MODEL_CONTEXT_WINDOW=128000

# ================================================
# 其他配置 DeepSeek 官网
# ================================================
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-xxx
MODEL_ID=deepseek-chat
MODEL_CONTEXT_WINDOW=128000

# LLM_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=sk-xxx
# MODEL_ID=deepseek-chat
# MODEL_CONTEXT_WINDOW=128000
